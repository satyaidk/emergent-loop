# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# Used by both the app (tutor replies) and the Hindsight container (memory extraction).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Where the Hindsight server is. docker-compose overrides this for the app container.
LEARNLOOP_HINDSIGHT_URL=http://localhost:8888

# Optional tuning (defaults shown)
# LEARNLOOP_OPENAI_MODEL=gpt-5-mini
# LEARNLOOP_EFFORT=low
# LEARNLOOP_RECALL_BUDGET=mid
# LEARNLOOP_RECALL_MAX_TOKENS=2000
