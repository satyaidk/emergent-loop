# Copy to .env and fill in. Never commit .env (it's in .gitignore).
# Pick ONE option below: keep its lines, and delete (or put # in front of) the other option's lines.

# ---------------------------------------------------------------------------
# Option A: OpenAI (paid; needs credits on your account)
# Get a key at https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
HINDSIGHT_API_LLM_PROVIDER=openai
# LEARNLOOP_OPENAI_MODEL=gpt-5-mini

# ---------------------------------------------------------------------------
# Option B: Ollama on your own computer (free, offline, no account)
# 1. Install Ollama from https://ollama.com and run:  ollama pull qwen3:4b-instruct
# 2. Use these lines instead of Option A.
#    host.docker.internal means "my computer" from inside a Docker container.
#    Running the app without Docker? Use http://localhost:11434/v1 for LEARNLOOP_OPENAI_BASE_URL.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=ollama
# LEARNLOOP_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# LEARNLOOP_OPENAI_MODEL=qwen3:4b-instruct
# LEARNLOOP_EFFORT=
# LEARNLOOP_MAX_TOKENS=2000
# HINDSIGHT_API_LLM_PROVIDER=ollama
# HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
# HINDSIGHT_API_LLM_MODEL=qwen3:4b-instruct
# Small models need these so Hindsight's note extraction stays within their limits:
# HINDSIGHT_API_LLM_STRICT_SCHEMA=true
# HINDSIGHT_API_LLM_OLLAMA_NUM_CTX=8192
# HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=4000
# HINDSIGHT_API_RETAIN_CHUNK_SIZE=2000
# A laptop model can need several minutes to turn a chat into notes. Hindsight's defaults (120s,
# and 30s for the progress report) make those jobs time out and restart; background jobs can wait.
# HINDSIGHT_API_RETAIN_LLM_TIMEOUT=900
# HINDSIGHT_API_CONSOLIDATION_LLM_TIMEOUT=900
# HINDSIGHT_API_REFLECT_LLM_TIMEOUT=300

# ---------------------------------------------------------------------------
# Shared settings
# ---------------------------------------------------------------------------
# Where the Hindsight server is. docker-compose overrides this for the app container.
LEARNLOOP_HINDSIGHT_URL=http://localhost:8888

# Optional tuning (defaults shown)
# LEARNLOOP_EFFORT=low
# LEARNLOOP_RECALL_BUDGET=mid
# LEARNLOOP_RECALL_MAX_TOKENS=2000
# LEARNLOOP_RECALL_MAX_NOTES=6
